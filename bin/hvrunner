#!/usr/bin/env python3
"""Entry point for running from a checkout without installing the package.

The affinity watcher re-executes this file when hvrunner is not on PATH, so it
has to stay at a stable location inside the repository.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from hvrunner.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
